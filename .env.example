DATABASE_URL=postgresql://user:password@host:5432/dbname
DIRECT_URL=postgresql://user:password@host:5432/dbname
PORT=4404
BASE_URL=http://localhost:4404

# Single-network deployment — one PayGate service serves one network only.
# Allowed values: base | base-sepolia | ethereum | polygon
NETWORK=

RELAYER_PRIVATE_KEY=
SETTLEMENT_STRICT=
ADMIN_API_KEY=
DEMO_MERCHANT_WALLET=0x0000000000000000000000000000000000000001
CORS_ORIGIN=*

# RPC URLs — the one matching NETWORK is required (except base-sepolia,
# which falls back to viem's public RPC if unset).
BASE_SEPOLIA_RPC_URL=
BASE_MAINNET_RPC_URL=
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
